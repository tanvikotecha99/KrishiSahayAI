@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Account - KrishiSahay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --ks-green: #2f7d32;
            --ks-dark-green: #1f5e24;
            --ks-dark: #173b1c;
            --ks-text: #5f6f63;
            --ks-light-green: #edf7ee;
            --ks-border: #d6e2d5;
            --ks-white: #ffffff;
            --ks-background: #f8fbf7;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background: var(--ks-background);
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

            color: var(--ks-dark);
        }

        .ks-auth-page {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 45px 20px;
        }

        .ks-auth-card {
            width: 100%;
            max-width: 560px;

            background: var(--ks-white);

            border: 1px solid var(--ks-border);
            border-radius: 28px;

            padding: 42px 46px;

            box-shadow:
                0 18px 50px rgba(30, 80, 35, 0.08);
        }

        .ks-auth-brand {
            text-align: center;
            margin-bottom: 30px;
        }

        .ks-auth-brand-icon {
            width: 68px;
            height: 68px;

            margin: 0 auto 18px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: var(--ks-light-green);

            border-radius: 20px;

            font-size: 32px;
        }

        .ks-auth-brand h1 {
            margin: 0 0 8px;

            color: var(--ks-dark);

            font-size: 32px;
            font-weight: 800;

            letter-spacing: -0.5px;
        }

        .ks-auth-brand p {
            margin: 0;

            color: var(--ks-text);

            font-size: 15px;
            line-height: 1.6;
        }

        .ks-auth-form {
            width: 100%;
        }

        .ks-auth-form .form-floating {
            margin-bottom: 16px;
        }

        .ks-auth-form .form-control {
            border: 1px solid var(--ks-border);

            border-radius: 12px;

            background: #fbfdfb;

            min-height: 52px;

            color: var(--ks-dark);

            box-shadow: none;
        }

        .ks-auth-form .form-control:focus {
            border-color: var(--ks-green);

            box-shadow:
                0 0 0 3px rgba(47, 125, 50, 0.10);

            background: var(--ks-white);
        }

        .ks-auth-form .form-floating > label {
            color: #718075;
        }

        .ks-auth-form .btn-primary {
            width: 100%;

            min-height: 52px;

            margin-top: 8px;

            border: none;
            border-radius: 12px;

            background: var(--ks-green);

            font-weight: 700;
            font-size: 16px;

            transition: .25s ease;
        }

        .ks-auth-form .btn-primary:hover {
            background: var(--ks-dark-green);

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(47, 125, 50, 0.18);
        }

        .ks-auth-form .btn-primary:active {
            transform: translateY(0);
        }

        .ks-auth-validation {
            color: #c0392b;

            font-size: 13px;

            margin-top: 6px;
        }

        .ks-auth-validation-summary {
            margin-bottom: 18px;

            padding: 12px 14px;

            border-radius: 10px;

            background: #fff4f4;

            border: 1px solid #f0caca;

            color: #c0392b;

            font-size: 13px;
        }

        .ks-auth-links {
            text-align: center;

            margin-top: 25px;

            color: var(--ks-text);

            font-size: 14px;
        }

        .ks-auth-links a {
            color: var(--ks-green);

            font-weight: 700;

            text-decoration: none;
        }

        .ks-auth-links a:hover {
            color: var(--ks-dark-green);

            text-decoration: underline;
        }

        @@media (max-width: 600px) {

            .ks-auth-page {
                padding: 30px 15px 45px;
            }

            .ks-auth-card {
                padding: 32px 22px;

                border-radius: 22px;
            }

            .ks-auth-brand h1 {
                font-size: 28px;
            }

            .ks-auth-brand-icon {
                width: 62px;
                height: 62px;

                font-size: 29px;
            }
        }
    </style>
</head>

<body>

    <main class="ks-auth-page">

        <section class="ks-auth-card">

            <!-- BRAND -->
            <div class="ks-auth-brand">

                <div class="ks-auth-brand-icon">
                    🌱
                </div>

                <h1>
                    Create your account
                </h1>

                <p>
                    Join KrishiSahay and start your farming journey
                </p>

            </div>


            <!-- REGISTER FORM -->
            <form id="registerForm"
                  class="ks-auth-form"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="ks-auth-validation-summary"
                     role="alert">
                </div>


                <!-- EMAIL -->
                <div class="form-floating">

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />

                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <span asp-validation-for="Input.Email"
                          class="ks-auth-validation">
                    </span>

                </div>


                <!-- PASSWORD -->
                <div class="form-floating">

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Password" />

                    <label asp-for="Input.Password">
                        Password
                    </label>

                    <span asp-validation-for="Input.Password"
                          class="ks-auth-validation">
                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->
                <div class="form-floating">

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm Password" />

                    <label asp-for="Input.ConfirmPassword">
                        Confirm Password
                    </label>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="ks-auth-validation">
                    </span>

                </div>


                <!-- REGISTER BUTTON -->
                <button id="registerSubmit"
                        type="submit"
                        class="btn btn-primary">

                    Create Account

                </button>

            </form>


            <!-- LOGIN LINK -->
            <div class="ks-auth-links">

                Already have an account?

                <a asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl">

                    Log in

                </a>

            </div>

        </section>

    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>