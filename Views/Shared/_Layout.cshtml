<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - KrishiSahay
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/krishisahay.css"
          asp-append-version="true" />

</head>

<body>

    <!-- =========================================================
         HEADER / NAVIGATION
         ========================================================= -->

    <header class="ks-navbar">

        <div class="ks-navbar-inner">

            <!-- BRAND -->

            <a asp-controller="Home"
               asp-action="Index"
               class="ks-brand">

                <span class="ks-brand-icon">
                    🌱
                </span>

                <span class="ks-brand-text">
                    KrishiSahay
                </span>

            </a>


            <!-- NAVIGATION -->

            <nav class="ks-nav">

                <!-- HOME -->

                <a asp-controller="Home"
                   asp-action="Index">

                    🏠 <span>Home</span>

                </a>


                <!-- MY FARMS -->

                <a asp-controller="Home"
                   asp-action="MyFarms">

                    🌱 <span>My Farms</span>

                </a>


                <!-- LEARN FARMING -->

                <a asp-controller="Home"
                   asp-action="Teach">

                    📖 <span>Learn Farming</span>

                </a>


                <!-- AI CROP DOCTOR -->

                <a asp-controller="Home"
                   asp-action="PublicCropDoctor"
                   title="Upload a crop photo and check your crop with AI">

                    🔍 <span>AI Crop Doctor</span>

                </a>


                <!-- ASK AI -->

                <a asp-controller="Home"
                   asp-action="AskAI">

                    ✨ <span>Ask AI</span>

                </a>


                <!-- WEATHER -->

                <a asp-controller="Weather"
                   asp-action="Select">

                    ☁️ <span>Weather</span>

                </a>


                <!-- LOGIN / REGISTER -->

                <partial name="_LoginPartial" />

            </nav>


            <!-- MOBILE MENU BUTTON -->

            <button type="button"
                    class="ks-mobile-menu-toggle"
                    aria-label="Open menu"
                    aria-expanded="false"
                    onclick="toggleKrishiSahayMenu(this)">

                ☰

            </button>

        </div>

    </header>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="border-top footer text-muted">

        <div class="container">

            © 2026 -
            <span class="ks-footer-brand">
                Tanvi Infotech
            </span>
            | KrishiSahay

        </div>

    </footer>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- MOBILE MENU -->

    <script>

        function toggleKrishiSahayMenu(button) {

            document.body.classList.toggle(
                "ks-mobile-menu-open"
            );

            const isOpen =
                document.body.classList.contains(
                    "ks-mobile-menu-open"
                );

            button.setAttribute(
                "aria-expanded",
                isOpen ? "true" : "false"
            );

            button.innerHTML =
                isOpen ? "✕" : "☰";
        }


        /* Close menu after clicking a link */

        document.addEventListener(
            "click",
            function (event) {

                const link =
                    event.target.closest(
                        ".ks-nav a"
                    );

                if (!link) return;

                document.body.classList.remove(
                    "ks-mobile-menu-open"
                );

                const button =
                    document.querySelector(
                        ".ks-mobile-menu-toggle"
                    );

                if (button) {

                    button.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    button.innerHTML = "☰";
                }

            }
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>