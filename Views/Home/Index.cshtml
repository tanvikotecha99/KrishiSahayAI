@{
    ViewData["Title"] = "KrishiSahay AI";
}

<link rel="stylesheet" href="~/css/krishisahay.css" />

<div class="ks-dashboard">

    <!-- HERO -->
    <section class="ks-hero">

        <div class="ks-hero-content">

            <div class="ks-badge">
                🌱 AI-powered farming assistant
            </div>

            <h1>
                Grow with confidence.<br />
                <span>Farm with KrishiSahay.</span>
            </h1>

            <p>
                Learn farming from the beginning, understand your soil and water,
                choose the right crop, monitor your farm and get AI-powered guidance
                throughout your farming journey.
            </p>

            <div class="ks-hero-buttons">

                <a href="/Home/Onboarding"
                   class="ks-btn ks-btn-primary">
                    🚜 Start My Farm Journey
                </a>

                <a href="/Home/Teach"
                   class="ks-btn ks-btn-secondary">
                    🎓 Learn Farming
                </a>

            </div>

        </div>

        <div class="ks-hero-visual">

            <div class="ks-farm-card">

                <div class="ks-sun">☀️</div>

                <div class="ks-cloud cloud-one">☁️</div>
                <div class="ks-cloud cloud-two">☁️</div>

                <div class="ks-field">

                    <div class="ks-plant plant-one">🌱</div>
                    <div class="ks-plant plant-two">🌱</div>
                    <div class="ks-plant plant-three">🌱</div>
                    <div class="ks-plant plant-four">🌱</div>

                </div>

                <div class="ks-farmer">
                    👨‍🌾
                </div>

            </div>

        </div>

    </section>


    <!-- FEATURES -->

    <section class="ks-section">

        <div class="ks-section-heading">

            <span>WHAT YOU CAN DO</span>

            <h2>
                Your complete farming companion
            </h2>

            <p>
                From your first question to your first harvest.
            </p>

        </div>


        <div class="ks-feature-grid">


            <!-- CARD 1 -->

            <a href="/Home/Teach"
               class="ks-feature-card">

                <div class="ks-icon">
                    🎓
                </div>

                <h3>
                    Learn Farming
                </h3>

                <p>
                    Start from the basics and learn soil,
                    water, crops and farming techniques.
                </p>

                <span class="ks-card-link">
                    Start learning →
                </span>

            </a>


            <!-- CARD 2 -->

            <a href="/Home/Soil"
               class="ks-feature-card">

                <div class="ks-icon">
                    🌱
                </div>

                <h3>
                    Soil & Water
                </h3>

                <p>
                    Understand your soil type, water source
                    and what your crops need.
                </p>

                <span class="ks-card-link">
                    Explore →
                </span>

            </a>


            <!-- CARD 3 -->

            <a href="/Home/CropGuide"
               class="ks-feature-card">

                <div class="ks-icon">
                    🌾
                </div>

                <h3>
                    Choose Your Crop
                </h3>

                <p>
                    Explore crops and understand planting,
                    growth and harvesting requirements.
                </p>

                <span class="ks-card-link">
                    Explore crops →
                </span>

            </a>


            <!-- CARD 4 -->

            <a href="/Home/ModernFarming"
               class="ks-feature-card">

                <div class="ks-icon">
                    💧
                </div>

                <h3>
                    Modern Farming
                </h3>

                <p>
                    Learn hydroponics, vertical farming,
                    greenhouse and indoor farming.
                </p>

                <span class="ks-card-link">
                    Discover →
                </span>

            </a>


            <!-- CARD 5 -->

            <a href="/Home/Assistant"
               class="ks-feature-card">

                <div class="ks-icon">
                    🤖
                </div>

                <h3>
                    Ask KrishiSahay
                </h3>

                <p>
                    Ask farming questions and get personalized
                    AI-powered guidance.
                </p>

                <span class="ks-card-link">
                    Ask AI →
                </span>

            </a>


            <!-- CARD 6 -->

            <a href="/Home/CheckCrop"
               class="ks-feature-card">

                <div class="ks-icon">
                    📷
                </div>

                <h3>
                    Check My Crop
                </h3>

                <p>
                    Upload a crop photo and describe what
                    you're observing for AI-assisted analysis.
                </p>

                <span class="ks-card-link">
                    Check crop →
                </span>

            </a>


        </div>

    </section>


    <!-- FARM JOURNEY -->

    <section class="ks-journey-section">

        <div class="ks-section-heading">

            <span>YOUR FARM JOURNEY</span>

            <h2>
                From seed to harvest
            </h2>

            <p>
                KrishiSahay stays with you throughout the farming cycle.
            </p>

        </div>


        <div class="ks-journey">

            <div class="ks-journey-step">
                <div>📍</div>
                <span>Know your farm</span>
            </div>

            <div class="ks-journey-line"></div>

            <div class="ks-journey-step">
                <div>🌱</div>
                <span>Prepare</span>
            </div>

            <div class="ks-journey-line"></div>

            <div class="ks-journey-step">
                <div>🌾</div>
                <span>Plant</span>
            </div>

            <div class="ks-journey-line"></div>

            <div class="ks-journey-step">
                <div>📷</div>
                <span>Monitor</span>
            </div>

            <div class="ks-journey-line"></div>

            <div class="ks-journey-step">
                <div>🌾</div>
                <span>Harvest</span>
            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="ks-final-cta">

        <div>

            <h2>
                Ready to start farming?
            </h2>

            <p>
                Tell KrishiSahay about your farm and we'll build
                your personalized journey.
            </p>

        </div>

        <a href="/Home/Onboarding"
           class="ks-btn ks-btn-light">
            Create My Farm →
        </a>

    </section>

</div>