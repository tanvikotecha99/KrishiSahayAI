@model KrishiSahayAI.Models.FarmCrop

@{
    ViewData["Title"] = "Crop Dashboard";

    var farm = ViewBag.Farm as KrishiSahayAI.Models.FarmProfile;

      bool budgetAvailable =
        farm != null &&
        farm.Budget > 0;

    bool soilAvailable =
        farm != null &&
        !string.IsNullOrWhiteSpace(farm.SoilType);

    bool waterAvailable =
        farm != null &&
        !string.IsNullOrWhiteSpace(farm.WaterSource);

    bool farmingMethodAvailable =
        farm != null &&
        !string.IsNullOrWhiteSpace(farm.FarmingMethod);


    // =============================================================
    // GEMINI AI FARM BUDGET ALLOCATION
    // =============================================================

    var geminiBudget =
        ViewBag.GeminiBudgetAllocation;

    decimal geminiAllocatedAmount = 0;

    decimal geminiAllocationPercent = 0;

    bool hasGeminiBudget =
        geminiBudget != null;

    if (hasGeminiBudget)
    {
        geminiAllocatedAmount =
            (decimal)geminiBudget.AllocatedAmount;

        geminiAllocationPercent =
            (decimal)geminiBudget.Percentage;
    }
}

<div class="ks-page">

    <div class="ks-container">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <div class="ks-page-header">

            <div>

                <div class="ks-eyebrow">
                    🌾 CROP DASHBOARD
                </div>

                <h1>
                    @Model.CropName
                </h1>

                <p>
                    Your crop dashboard for
                    <strong>
                        @farm?.FarmerName's Farm
                    </strong>.
                </p>

            </div>

            <div>

                <a asp-controller="Home"
                   asp-action="MyCrops"
                   asp-route-farmId="@farm?.Id"
                   class="ks-btn ks-btn-outline">

                    ← My Crops

                </a>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- CROP SUMMARY -->
        <!-- ===================================================== -->

        <div class="ks-card"
             style="margin-bottom:25px;">

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:flex-start;
                gap:20px;
                flex-wrap:wrap;">

                <div>

                    <div class="ks-eyebrow">
                        CROP #@Model.Id
                    </div>

                    <h2 style="margin:5px 0;">
                        @Model.CropName
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Variety))
                    {
                        <p style="margin:0;">
                            Variety: @Model.Variety
                        </p>
                    }

                    @if (farm != null)
                    {
                        <p style="margin:8px 0 0;">

                            📍 @farm.Location

                            &nbsp; • &nbsp;

                            🌾 Farm #@farm.Id

                        </p>
                    }

                </div>

                <div style="font-size:52px;">
                    🌱
                </div>

            </div>

            <!-- CROP DETAILS -->

<div class="ks-crop-summary-stats"
     style="
        display:grid;
        grid-template-columns:repeat(4, 1fr);
        gap:18px;
        margin-top:30px;">

    <!-- SEASON -->

    <div class="ks-summary-stat">

        <div class="ks-summary-label">
            SEASON
        </div>

        <div class="ks-summary-value">

            @(string.IsNullOrWhiteSpace(Model.Season)
                ? "Not specified"
                : Model.Season)

        </div>

    </div>


    <!-- AREA -->

    <div class="ks-summary-stat">

        <div class="ks-summary-label">
            AREA
        </div>

        <div class="ks-summary-value">

            @Model.Area @Model.AreaUnit

        </div>

    </div>


    <!-- SOWING DATE -->

    <div class="ks-summary-stat">

        <div class="ks-summary-label">
            SOWING DATE
        </div>

        <div class="ks-summary-value">

            @(Model.SowingDate.HasValue
                ? Model.SowingDate.Value.ToString("dd MMM yyyy")
                : "Not specified")

        </div>

    </div>


    <!-- ADDED -->

    <div class="ks-summary-stat">

        <div class="ks-summary-label">
            ADDED
        </div>

        <div class="ks-summary-value">

            @(Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))

        </div>

    </div>

</div>


        <!-- ===================================================== -->
        <!-- CROP CONTEXT -->
        <!-- ===================================================== -->

        <div class="ks-eyebrow" style="margin-top:30px;">
            CROP CONTEXT
        </div>

        <h2 style="margin-top:5px;">
            Your @Model.CropName farming context
        </h2>

        <p style="max-width:800px;">
            KrishiSahay uses the information available for this
            farm and crop to keep recommendations relevant to
            your farming situation.
        </p>


      <div class="ks-grid ks-context-grid"
     style="margin-top:20px;">

            <!-- ================================================= -->
            <!-- SOIL CONTEXT -->
            <!-- ================================================= -->

            <div class="ks-card">

                <div style="
                    font-size:40px;
                    margin-bottom:15px;">
                    🌱
                </div>

                <div class="ks-eyebrow">
                    SOIL CONTEXT
                </div>

                <h3>
                    Soil Information
                </h3>

                @if (soilAvailable)
                {
                    <p>
                        <strong>Farm soil:</strong>
                        @farm!.SoilType
                    </p>
                }
                else
                {
                    <p>
                        Soil information has not been provided
                        in the farm profile yet.
                    </p>
                }

                <p style="
                    font-size:13px;
                    color:#666;">

                    This is farm-profile information and should
                    not be treated as a laboratory soil analysis.

                </p>

                <a asp-controller="Home"
                   asp-action="SoilAssessment"
                   asp-route-farmId="@farm?.Id"
                   asp-route-cropId="@Model.Id"
                   class="ks-btn ks-btn-outline"
                   style="margin-top:10px;">

                    🌱 View Soil Assessment →

                </a>

            </div>


            <!-- ================================================= -->
            <!-- WATER CONTEXT -->
            <!-- ================================================= -->

            <div class="ks-card">

                <div style="
                    font-size:40px;
                    margin-bottom:15px;">
                    💧
                </div>

                <div class="ks-eyebrow">
                    WATER CONTEXT
                </div>

                <h3>
                    Water Information
                </h3>

                @if (waterAvailable)
                {
                    <p>
                        <strong>Water source:</strong>
                        @farm!.WaterSource
                    </p>
                }
                else
                {
                    <p>
                        Water source has not been provided
                        in the farm profile yet.
                    </p>
                }

                <p style="
                    font-size:13px;
                    color:#666;">

                    Use the assessment section to record more
                    detailed water and irrigation information.

                </p>

                <a asp-controller="Home"
                   asp-action="WaterAssessment"
                   asp-route-farmId="@farm?.Id"
                   asp-route-cropId="@Model.Id"
                   class="ks-btn ks-btn-outline"
                   style="margin-top:10px;">

                    💧 View Water Assessment →

                </a>

            </div>


            <!-- ================================================= -->
            <!-- FARMING METHOD -->
            <!-- ================================================= -->

            <div class="ks-card">

    <div style="
        font-size:40px;
        margin-bottom:15px;">
        🚜
    </div>

    <div class="ks-eyebrow">
        FARMING METHOD
    </div>

    <h3>
        Farming Approach
    </h3>

    @if (farmingMethodAvailable)
    {
        <p>
            <strong>
                @farm!.FarmingMethod
            </strong>
        </p>
    }
    else
    {
        <p>
            Farming method has not been specified
            yet.
        </p>
    }

    <p style="
                    font-size:13px;
                    color:#666;">
        Learn more about farming methods and how
        different approaches can support your crop.
    </p>

       <a asp-controller="Home"
       asp-action="Teach"
       class="ks-btn ks-btn-outline"
       style="margin-top:15px;">

        🌱 Learn Farming →

    </a>

</div>

</div>


<!-- ===================================================== -->
<!-- AI CROP BUDGET -->
<!-- ===================================================== -->

<div class="ks-card"
     style="
        margin-top:25px;
        margin-bottom:30px;">

    <div style="
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:25px;
        flex-wrap:wrap;">

        <div style="flex:1;">

            <div class="ks-eyebrow">
                🤖 AI BUDGET PLANNING
            </div>

            <h2 style="margin:5px 0;">
                Gemini Crop Budget Allocation
            </h2>

            <p>
                Gemini analyzes all crops on this farm,
                their allocated areas and available farm
                context to estimate how the total farm
                budget can be distributed.
            </p>

        </div>

        <div style="
            font-size:44px;
            min-width:70px;
            text-align:center;">
            🤖
        </div>

    </div>


    @if (hasGeminiBudget)
    {

        <!-- ================================================= -->
        <!-- BUDGET SUMMARY -->
        <!-- ================================================= -->

        <div class="ks-budget-stats"
             style="
                display:grid;
                grid-template-columns:repeat(4, 1fr);
                gap:20px;
                margin-top:25px;">

            <!-- FULL FARM BUDGET -->

            <div style="
                padding:20px;
                border-radius:14px;
                background:#f5faf5;">

                <div style="
                    font-size:13px;
                    color:#666;
                    margin-bottom:6px;">

                    FULL FARM BUDGET

                </div>

                <strong style="font-size:24px;">

                    ₹@farm!.Budget.ToString("N0")

                </strong>

                <div style="
                    margin-top:6px;
                    font-size:13px;
                    color:#777;">

                    Total budget for this farm

                </div>

            </div>


            <!-- TOTAL FARM AREA -->

            <div style="
                padding:20px;
                border-radius:14px;
                background:#f5faf5;">

                <div style="
                    font-size:13px;
                    color:#666;
                    margin-bottom:6px;">

                    TOTAL FARM AREA

                </div>

                <strong style="font-size:24px;">

                    @farm.LandSize @farm.LandUnit

                </strong>

                <div style="
                    margin-top:6px;
                    font-size:13px;
                    color:#777;">

                    Complete farm area

                </div>

            </div>


            <!-- THIS CROP -->

            <div style="
                padding:20px;
                border-radius:14px;
                background:#f5faf5;">

                <div style="
                    font-size:13px;
                    color:#666;
                    margin-bottom:6px;">

                    THIS CROP

                </div>

                <strong style="font-size:24px;">

                    @Model.CropName

                </strong>

                <div style="
                    margin-top:6px;
                    font-size:13px;
                    color:#777;">

                    @Model.Area @Model.AreaUnit

                </div>

            </div>


            <!-- GEMINI ALLOCATION -->

            <div style="
                padding:20px;
                border-radius:14px;
                background:#eef8ef;">

                <div style="
                    font-size:13px;
                    color:#666;
                    margin-bottom:6px;">

                    GEMINI ALLOCATION

                </div>

                <strong style="
                    font-size:24px;
                    color:#246b2a;">

                    ₹@geminiAllocatedAmount.ToString("N0")

                </strong>

                <div style="
                    margin-top:6px;
                    font-size:13px;
                    color:#777;">

                    AI-estimated allocation

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- GEMINI BUDGET SHARE -->
        <!-- ================================================= -->

        <div style="
            margin-top:18px;
            padding:20px;
            border-radius:14px;
            background:#f8fbf8;
            border:1px solid #e1ebe1;">

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                gap:15px;
                flex-wrap:wrap;">

                <div>

                    <div style="
                        font-size:13px;
                        font-weight:700;
                        color:#666;
                        letter-spacing:0.04em;">

                        🤖 GEMINI AI BUDGET SHARE

                    </div>

                    <div style="
                        margin-top:6px;
                        color:#666;
                        font-size:14px;">

                        Percentage of the total farm budget
                        allocated to @Model.CropName.

                    </div>

                </div>

                <strong style="
                    font-size:30px;
                    color:#246b2a;">

                    @geminiAllocationPercent.ToString("0.#")%

                </strong>

            </div>


            <!-- PROGRESS BAR -->

            <div style="
                margin-top:15px;
                width:100%;
                height:10px;
                border-radius:999px;
                background:#e5e9e5;
                overflow:hidden;">

                <div style="
                    width:@geminiAllocationPercent%;
                    height:100%;
                    border-radius:999px;
                    background:#2f7d32;">
                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- AI EXPLANATION -->
        <!-- ================================================= -->

        <div style="
            margin-top:18px;
            padding:16px;
            border-radius:12px;
            background:#f5faf5;
            border:1px solid #e1ebe1;
            color:#555;
            font-size:14px;
            line-height:1.6;">

            🤖 <strong>How Gemini allocated this budget:</strong>

            Gemini considers the total farm budget,
            all crops on the farm, crop areas and available
            farm context. Different crops may receive
            different allocations because their expected
            resource requirements can differ.

        </div>


        <!-- ================================================= -->
        <!-- DISCLAIMER -->
        <!-- ================================================= -->

        <div style="
            margin-top:18px;
            padding:14px 16px;
            border-radius:10px;
            background:#fafafa;
            border:1px solid #e5e5e5;
            font-size:13px;
            color:#666;">

            💡 <strong>AI planning estimate:</strong>

            This allocation is generated using the available
            farm and crop information. It is not an exact
            market quotation, input price, or guaranteed
            production expense.

        </div>

    }

    else if (budgetAvailable)
    {

        <!-- ================================================= -->
        <!-- GEMINI UNAVAILABLE -->
        <!-- ================================================= -->

        <div style="
            margin-top:20px;
            padding:18px;
            border-radius:12px;
            background:#fafafa;">

            <div class="ks-eyebrow">
                💰 FARM BUDGET
            </div>

            <strong style="font-size:24px;">

                ₹@farm!.Budget.ToString("N0")

            </strong>

            <p style="
                margin:8px 0 0;
                color:#666;">

                Gemini could not generate the AI budget
                allocation at this time.

            </p>

            @if (!string.IsNullOrWhiteSpace(
                ViewBag.GeminiBudgetError as string))
            {
                <p style="
                    margin:8px 0 0;
                    color:#8a6d1d;">

                    🤖 @ViewBag.GeminiBudgetError

                </p>
            }

        </div>

    }

    else
    {

        <div style="
            margin-top:20px;
            padding:18px;
            border-radius:12px;
            background:#fafafa;">

            <strong>
                Budget information not available.
            </strong>

            <p style="
                margin:8px 0 0;
                color:#666;">

                Add or update the approximate farm budget
                to enable AI budget planning.

            </p>

        </div>

    }

</div>
        <!-- ===================================================== -->
        <!-- AI GUIDANCE -->
        <!-- ===================================================== -->

        <div class="ks-eyebrow">
            🤖 AI GUIDANCE
        </div>

        <h2 style="margin-top:5px;">
            Get guidance for @Model.CropName
        </h2>

      <div class="ks-grid ks-ai-guidance-grid"
     style="margin-top:20px;">

            <!-- ASK AI -->

            <div class="ks-card">

                <div style="
                    font-size:40px;
                    margin-bottom:15px;">
                    🤖
                </div>

                <div class="ks-eyebrow">
                    AI ASSISTANT
                </div>

                <h3>
                    Ask KrishiSahay AI
                </h3>

                <p>
                    Ask questions about @Model.CropName and get
                    guidance using your farm context.
                </p>

                <a asp-controller="Home"
                   asp-action="AskAI"
                   asp-route-farmId="@farm?.Id"
                   asp-route-cropId="@Model.Id"
                   class="ks-btn ks-btn-primary"
                   style="margin-top:15px;">

                    🤖 Ask KrishiSahay AI →

                </a>

            </div>


            <!-- WEATHER -->

            <div class="ks-card">

                <div style="
                    font-size:40px;
                    margin-bottom:15px;">
                    🌦️
                </div>

                <div class="ks-eyebrow">
                    WEATHER
                </div>

                <h3>
                    Crop Weather
                </h3>

                <p>
                    Check weather conditions for your farm and
                    understand how they may affect your crop.
                </p>

                <a asp-controller="Weather"
                   asp-action="Index"
                   asp-route-farmId="@farm?.Id"
                   asp-route-cropId="@Model.Id"
                   class="ks-btn ks-btn-outline"
                   style="margin-top:15px;">

                    🌦️ Check Weather →

                </a>

            </div>


            <!-- CROP DOCTOR -->

            <div class="ks-card">

                <div style="
                    font-size:40px;
                    margin-bottom:15px;">
                    🔬
                </div>

                <div class="ks-eyebrow">
                    AI DIAGNOSIS
                </div>

                <h3>
                    AI Crop Doctor
                </h3>

                <p>
                    Upload a crop photo and describe what you
                    are observing. KrishiSahay AI can analyze
                    the image and provide an AI-assisted
                    observation.
                </p>

                <a asp-controller="Home"
                   asp-action="CropDoctor"
                   asp-route-farmId="@farm?.Id"
                   asp-route-cropId="@Model.Id"
                   class="ks-btn ks-btn-primary"
                   style="margin-top:15px;">

                    🔬 Check My Crop →

                </a>

            </div>


            <!-- CROP HISTORY -->

            <div class="ks-card">

                <div style="
                    font-size:40px;
                    margin-bottom:15px;">
                    📋
                </div>

                <div class="ks-eyebrow">
                    CROP HISTORY
                </div>

                <h3>
                    Crop Doctor History
                </h3>

                <p>
                    View previous AI crop checks and observations
                    recorded for this crop.
                </p>

                <a asp-controller="Home"
                   asp-action="CropDoctor"
                   asp-route-farmId="@farm?.Id"
                   asp-route-cropId="@Model.Id"
                   class="ks-btn ks-btn-outline"
                   style="margin-top:15px;">

                    📋 View Crop History →

                </a>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- QUICK FARM CONTEXT -->
        <!-- ===================================================== -->

        @if (farm != null)
        {

            <div class="ks-card"
                 style="margin-top:30px;">

                <div class="ks-eyebrow">
                    🌾 FARM CONTEXT
                </div>

                <h2 style="margin-top:5px;">
                    Information used for your crop
                </h2>

                <div style="
                    display:grid;
                    grid-template-columns:repeat(3, 1fr);
                    gap:18px;
                    margin-top:20px;">

                    <div>

                        <strong>
                            Location
                        </strong>

                        <div>
                            📍 @farm.Location
                        </div>

                    </div>


                    <div>

                        <strong>
                            Farm Area
                        </strong>

                        <div>
                           @farm!.LandSize @farm.LandUnit
                        </div>

                    </div>


                    <div>

                        <strong>
                            Water Source
                        </strong>

                        <div>
                            @(string.IsNullOrWhiteSpace(
                                farm.WaterSource)
                                ? "Not specified"
                                : farm.WaterSource)
                        </div>

                    </div>


                    <div>

                        <strong>
                            Soil
                        </strong>

                        <div>
                            @(string.IsNullOrWhiteSpace(
                                farm.SoilType)
                                ? "Not specified"
                                : farm.SoilType)
                        </div>

                    </div>


                    <div>

                        <strong>
                            Farming Method
                        </strong>

                        <div>
                            @(string.IsNullOrWhiteSpace(
                                farm.FarmingMethod)
                                ? "Not specified"
                                : farm.FarmingMethod)
                        </div>

                    </div>


                    <div>

                        <strong>
                            Experience
                        </strong>

                        <div>
                            @(string.IsNullOrWhiteSpace(
                                farm.ExperienceLevel)
                                ? "Not specified"
                                : farm.ExperienceLevel)
                        </div>

                    </div>

                </div>

            </div>

        }


        <!-- ===================================================== -->
        <!-- BACK -->
        <!-- ===================================================== -->

        <div style="margin-top:30px;">

            <a asp-controller="Home"
               asp-action="MyCrops"
               asp-route-farmId="@farm?.Id"
               class="ks-btn ks-btn-outline">

                ← Back to My Crops

            </a>

        </div>

    </div>

</div>
<style>
    .ks-crop-summary-stats {
        align-items: stretch;
    }

    .ks-summary-stat {
        padding: 18px;
        border: 1px solid #e7ece7;
        border-radius: 14px;
        background: #fbfdfb;
        min-height: 82px;
        box-sizing: border-box;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .ks-summary-stat:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
    }

    .ks-summary-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #667085;
        margin-bottom: 8px;
    }

    .ks-summary-value {
        font-size: 17px;
        font-weight: 600;
        color: #1f2937;
        line-height: 1.4;
    }

    @@media (max-width: 900px) {
        .ks-crop-summary-stats {
            grid-template-columns: repeat(2, 1fr) !important;
        }
    }

    @@media (max-width: 600px) {
        .ks-crop-summary-stats {
            grid-template-columns: 1fr !important;
        }
    }

    .ks-context-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    align-items: stretch;
}

.ks-context-grid > .ks-card {
    height: 100%;
    box-sizing: border-box;
}
/* =========================================================
   CROP CONTEXT - BUTTON ALIGNMENT
   ========================================================= */

.ks-context-grid > .ks-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
}

.ks-context-grid > .ks-card > a.ks-btn {
    width: 100% !important;
    height: 54px !important;
    min-height: 54px !important;

    margin-top: auto !important;
    margin-bottom: 0 !important;

    box-sizing: border-box;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    text-align: center;
    padding: 12px 16px;
    line-height: 1.25;
}

.ks-context-grid > .ks-card > a.ks-btn-outline {
    background: #ffffff !important;
    border: 1px solid #2f7d32 !important;
    color: #2f7d32 !important;
}
@@media (max-width: 1000px) {
    .ks-context-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

@@media (max-width: 650px) {
    .ks-context-grid {
        grid-template-columns: 1fr !important;
    }
}

.ks-budget-stats {
    align-items: stretch;
}

.ks-budget-stats > div {
    box-sizing: border-box;
    min-height: 120px;
}

@@media (max-width: 1000px) {
    .ks-budget-stats {
        grid-template-columns: repeat(2, 1fr) !important;
    }
}


@@media (max-width: 550px) {
    .ks-budget-stats {
        grid-template-columns: 1fr !important;
    }
}
/* =========================================================
   AI GUIDANCE
   ========================================================= */

.ks-ai-guidance-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    align-items: stretch;
}

.ks-ai-guidance-grid > .ks-card {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}



